#!/usr/bin/env python3
"""Generate hyprsunset.conf from sun times + fixed bedtime (Flux-style)."""
from __future__ import annotations

import re
import subprocess
import sys
from datetime import date, datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

from astral import LocationInfo
from astral.sun import sun

LOCATION = Path.home() / ".config/hypr/location.conf"
OUTPUT = Path.home() / ".config/hypr/hyprsunset.conf"


def load_settings() -> tuple[LocationInfo, datetime.time]:
    vals = {
        "lat": 31.2304,
        "lon": 121.4737,
        "tz": "Asia/Shanghai",
        "city": "Shanghai",
        "sleep_time": "20:15",
    }
    if LOCATION.exists():
        text = LOCATION.read_text()
        for key, var in (
            ("latitude", "lat"),
            ("longitude", "lon"),
            ("timezone", "tz"),
            ("city", "city"),
            ("sleep_time", "sleep_time"),
        ):
            m = re.search(rf"^{key}\s*=\s*(\S+)", text, re.M)
            if m:
                vals[var] = m.group(1)
    loc = LocationInfo(
        vals["city"], "China", vals["tz"], float(vals["lat"]), float(vals["lon"])
    )
    bedtime = datetime.strptime(vals["sleep_time"], "%H:%M").time()
    return loc, bedtime


def fmt(t: datetime) -> str:
    return t.strftime("%H:%M")


def at_time(day: date, clock: datetime.time, tz: ZoneInfo) -> datetime:
    return datetime.combine(day, clock, tzinfo=tz)


def shift(t: datetime, minutes: int) -> datetime:
    return t + timedelta(minutes=minutes)


def main() -> int:
    loc, bedtime_clock = load_settings()
    tz = ZoneInfo(loc.timezone)
    today = datetime.now(tz).date()
    s = sun(loc.observer, date=today, tzinfo=tz)

    dawn = s["dawn"]
    sunrise = s["sunrise"]
    sunset = s["sunset"]
    bedtime = at_time(today, bedtime_clock, tz)

    # Evening ramp ends at fixed bedtime; morning follows local sun.
    # After ~19:30 must stay warmer/dimmer than earlier steps (no brightening).
    profiles: list[tuple[datetime, int | None, float | None, bool]] = [
        (shift(dawn, -30), 4200, 0.88, False),  # pre-dawn
        (sunrise, None, None, True),  # day: neutral
        (shift(bedtime, -90), 4800, 0.90, False),  # 18:45 — start wind-down
        (shift(bedtime, -45), 3000, 0.68, False),  # 19:30 — clearly darker/warmer
        (shift(bedtime, -15), 2500, 0.55, False),  # 20:00 — strong dim
        (bedtime, 2100, 0.48, False),  # 20:15 — sleep
    ]

    # If sunset falls inside the wind-down window, bridge toward the 19:30 step
    # (must not be brighter than the following 19:30 profile).
    wind_start = shift(bedtime, -90)
    wind_1930 = shift(bedtime, -45)
    if wind_start <= sunset < wind_1930:
        profiles.append((sunset, 3600, 0.78, False))
    elif wind_1930 <= sunset < bedtime:
        profiles.append((sunset, 2800, 0.60, False))

    profiles.sort(key=lambda item: item[0])

    lines = [
        "# Generated by hyprsunset-flux-schedule — Flux-style sun + bedtime tracking",
        f"# Location: {loc.name} ({loc.latitude:.4f}, {loc.longitude:.4f}) {loc.timezone}",
        f"# Date: {today}  sunrise {fmt(sunrise)}  sunset {fmt(sunset)}  sleep {bedtime_clock.strftime('%H:%M')}",
        "# Edit ~/.config/hypr/location.conf (sleep_time, coords) then re-run this script.",
        "",
        "max-gamma = 150",
        "",
    ]

    for time, temp, gamma, identity in profiles:
        lines.append("profile {")
        lines.append(f"    time = {fmt(time)}")
        if identity:
            lines.append("    identity = true")
        else:
            lines.append(f"    temperature = {temp}")
            lines.append(f"    gamma = {gamma}")
        lines.append("}")
        lines.append("")

    OUTPUT.write_text("\n".join(lines))
    print(f"Wrote {OUTPUT}")
    print(f"  Sleep target: {bedtime_clock.strftime('%H:%M')}")
    for time, temp, gamma, identity in profiles:
        label = "day" if identity else f"{temp}K gamma={gamma}"
        print(f"  {fmt(time)}  {label}")

    try:
        subprocess.run(
            ["systemctl", "--user", "restart", "hyprsunset.service"],
            check=False,
            capture_output=True,
        )
    except FileNotFoundError:
        pass

    return 0


if __name__ == "__main__":
    sys.exit(main())
