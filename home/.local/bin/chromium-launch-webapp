#!/usr/bin/env bash
# Launch a Chromium web app with Clash proxy (all traffic including Strava).
set -euo pipefail

source "${HOME}/.config/omarchy/proxy.sh" 2>/dev/null || true

PORT=$(_clash_mixed_port 2>/dev/null || echo 7897)
URL="${1:?Usage: chromium-launch-webapp <url> [profile-slug]}"
shift
PROFILE="${1:-}"

if [[ -z "$PROFILE" ]]; then
  PROFILE=$(python3 -c "import re,sys; u=sys.argv[1]; h=re.sub(r'^https?://','',u).split('/')[0]; print(re.sub(r'[^a-z0-9]+','-',h.lower()).strip('-') or 'webapp')" "$URL")
fi

PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/chromium-webapps/${PROFILE}"

if ! _clash_listening 2>/dev/null; then
  notify-send -u critical "Chromium web app" "Start Clash Verge first — needs proxy on 127.0.0.1:${PORT}." 2>/dev/null || \
    echo "Start Clash Verge first — web app needs proxy on 127.0.0.1:${PORT}" >&2
fi

exec setsid uwsm-app -- /usr/bin/chromium \
  "--user-data-dir=${PROFILE_DIR}" \
  "--proxy-server=http://127.0.0.1:${PORT}" \
  "--app=${URL}"
