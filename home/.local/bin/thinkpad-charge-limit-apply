#!/bin/bash

# Apply ThinkPad battery charge thresholds (AlDente-style 80% limit).

set -euo pipefail

END_THRESHOLD="${BATTERY_CHARGE_END:-80}"
START_THRESHOLD="${BATTERY_CHARGE_START:-75}"
USER_CONFIG="${HOME:-/root}/.config/omarchy/battery-charge-limit.conf"

for config in /etc/default/thinkpad-charge-limit "${USER_CONFIG}"; do
  if [[ -f ${config} ]]; then
    # shellcheck disable=SC1090
    source "${config}"
    break
  fi
done

apply_threshold() {
  local bat="$1"
  local end="$2"
  local start="$3"

  [[ -w ${bat}/charge_control_end_threshold ]] || return 0

  if [[ -w ${bat}/charge_control_start_threshold ]]; then
    if (( start >= end )); then
      start=$(( end - 5 ))
      (( start < 0 )) && start=0
    fi
    echo "${start}" >"${bat}/charge_control_start_threshold"
  fi

  echo "${end}" >"${bat}/charge_control_end_threshold"
  echo "Applied ${bat}: stop=${end}% start=${start}%"
}

shopt -s nullglob
batteries=(/sys/class/power_supply/BAT*/charge_control_end_threshold)

if ((${#batteries[@]} == 0)); then
  echo "No ThinkPad-style charge threshold controls found." >&2
  exit 0
fi

for end_file in "${batteries[@]}"; do
  apply_threshold "$(dirname "${end_file}")" "${END_THRESHOLD}" "${START_THRESHOLD}"
done
