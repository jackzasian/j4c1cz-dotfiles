#!/usr/bin/env bash
# Shared env for omarchy AUR helpers: HTTP proxy on, SOCKS ALL_PROXY off (breaks git).
set -euo pipefail

PROXY_SH="${HOME}/.config/omarchy/proxy.sh"
if [[ -f $PROXY_SH ]]; then
  # shellcheck source=/dev/null
  source "$PROXY_SH"
  proxy_on >/dev/null 2>&1 || true
fi
unset ALL_PROXY all_proxy
