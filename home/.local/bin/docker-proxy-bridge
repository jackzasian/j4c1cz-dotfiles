#!/usr/bin/env bash
# Forward Docker bridge -> Clash (127.0.0.1:7897) for container outbound HTTP(S).
set -euo pipefail

BRIDGE_IP="${DOCKER_BRIDGE_IP:-172.19.0.1}"
LISTEN_PORT="${DOCKER_PROXY_PORT:-7898}"
CLASH_PORT="${CLASH_HTTP_PORT:-7897}"

if ss -tln | rg -q "${BRIDGE_IP}:${LISTEN_PORT} "; then
  echo "docker-proxy-bridge already listening on ${BRIDGE_IP}:${LISTEN_PORT}"
  exit 0
fi

exec socat "TCP-LISTEN:${LISTEN_PORT},bind=${BRIDGE_IP},reuseaddr,fork" "TCP:127.0.0.1:${CLASH_PORT}"
