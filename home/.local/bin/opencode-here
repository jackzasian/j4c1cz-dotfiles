#!/usr/bin/env bash
# Start OpenCode in a scoped project workspace (never $HOME).
set -euo pipefail
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$BIN_DIR/agent-lib.sh"

# Ensure Clash shell proxy (Zellij panes are interactive, but be explicit).
if [[ -f "${HOME}/.config/omarchy/proxy.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/omarchy/proxy.sh"
  if [[ -z ${http_proxy:-} ]]; then
    proxy_on >/dev/null 2>&1 || true
  fi
fi

dir="$(agent_resolve_dir "${1:-$PWD}")" || exit 1
agent_refuse_home "$dir" || exit 1
agent_warn_budget
cd "$dir"
extra=()
if [[ $# -ge 1 ]]; then shift; extra=("$@"); fi
exec opencode "${extra[@]}"
