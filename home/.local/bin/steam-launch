#!/usr/bin/env bash
# Launch Steam without proxy — game downloads and CM must not use HTTP/SOCKS proxy.
# Clash fake-ip-filter + DIRECT prepend rules handle Steam connectivity instead.

set -euo pipefail

source "${HOME}/.config/omarchy/proxy.sh" 2>/dev/null || true
proxy_off 2>/dev/null || true

# env -u clears vars even when inherited from Hyprland / parent shell
exec env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
  -u ALL_PROXY -u all_proxy -u FTP_PROXY -u ftp_proxy \
  -u NPM_CONFIG_PROXY -u NPM_CONFIG_HTTPS_PROXY -u PIP_PROXY \
  /usr/bin/steam "$@"
