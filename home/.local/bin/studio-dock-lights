#!/usr/bin/env bash
# When Apple Studio Display is connected: zero laptop panel + keyboard backlight,
# and disable the laptop LCD (unless user forced it on with Super+Ctrl+Delete).
set -euo pipefail

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/studio-dock-lights"
STATE_FILE="${STATE_DIR}/levels"
WANT_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/laptop-display-want"
TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/$TOGGLE.conf"
PANEL_DEV="intel_backlight"
KBD_DEV="tpacpi::kbd_backlight"
STUDIO_RE='StudioDisplay|Studio Display'

mkdir -p "$STATE_DIR" "$(dirname "$WANT_FILE")" "$(dirname "$TOGGLE_FLAG")"

# Stable across hyprctl reload (hypr monitor list can briefly empty).
studio_connected() {
  local edid status
  for status in /sys/class/drm/card*-*/status; do
    [[ "$status" == *-eDP-*/status ]] && continue
    [[ -r "$status" ]] || continue
    [[ "$(<"$status")" == "connected" ]] || continue
    edid="${status%/status}/edid"
    if [[ -r "$edid" ]] && strings "$edid" 2>/dev/null | grep -qiE 'Studio ?Display'; then
      return 0
    fi
  done
  # Fallback: Hyprland description (any disabled/enabled)
  hyprctl monitors all -j 2>/dev/null | jq -e --arg re "$STUDIO_RE" '
    any(.[]; (.description // "") | test($re; "i"))
  ' >/dev/null 2>&1
}

user_wants_laptop() {
  [[ -f "$WANT_FILE" && "$(cat "$WANT_FILE" 2>/dev/null)" == "on" ]]
}

get_level() {
  brightnessctl --device="$1" get 2>/dev/null || echo 0
}

set_level() {
  local dev=$1 level=$2
  brightnessctl --device="$dev" set "$level" >/dev/null 2>&1 || true
}

save_levels() {
  local panel kbd
  panel=$(get_level "$PANEL_DEV")
  kbd=$(get_level "$KBD_DEV")
  if [[ "$panel" != "0" || "$kbd" != "0" ]]; then
    printf 'panel=%s\nkbd=%s\n' "$panel" "$kbd" >"$STATE_FILE"
  elif [[ ! -f "$STATE_FILE" ]]; then
    printf 'panel=%s\nkbd=%s\n' "$panel" "$kbd" >"$STATE_FILE"
  fi
}

load_var() {
  local key=$1 default=$2
  if [[ -f "$STATE_FILE" ]]; then
    local v
    v=$(grep -E "^${key}=" "$STATE_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)
    if [[ -n "${v:-}" ]]; then
      printf '%s\n' "$v"
      return
    fi
  fi
  printf '%s\n' "$default"
}

internal_desc() {
  hyprctl monitors all -j 2>/dev/null | jq -r '
    .[] | select(.name | test("eDP"; "i")) | .description
  ' | head -n 1
}

write_disable_flag() {
  local desc
  desc=$(internal_desc)
  [[ -n "$desc" ]] || return 1
  cat >"$TOGGLE_FLAG" <<EOF
monitorv2 {
  output = desc:${desc}
  disabled = true
}
EOF
}

cmd_dock() {
  save_levels
  set_level "$KBD_DEV" 0

  # Desk layout uses laptop for workspaces 5–7 — keep LCD on unless user
  # explicitly disabled it (want=off via Super+Ctrl+Delete).
  if [[ -f "$WANT_FILE" && "$(cat "$WANT_FILE" 2>/dev/null)" == "off" ]]; then
    set_level "$PANEL_DEV" 0
    write_disable_flag || true
    hyprctl reload >/dev/null 2>&1 || true
    echo "studio-dock-lights: dock (kbd→0, laptop LCD off — user want=off)"
  else
    echo on >"$WANT_FILE"
    rm -f "$TOGGLE_FLAG"
    set_level "$PANEL_DEV" "$(load_var panel 496)"
    # Split workspaces: 5–7 on laptop, rest on Studio
    if [[ -x "$HOME/.local/bin/workspaces-dock-apply" ]]; then
      "$HOME/.local/bin/workspaces-dock-apply" || true
    fi
    echo "studio-dock-lights: dock (kbd→0, laptop on for WS 5–7)"
  fi
}

cmd_undock() {
  # Refuse if Studio still present (guards reload flaps)
  if studio_connected; then
    echo "studio-dock-lights: undock skipped (Studio still connected)"
    return 0
  fi

  local panel kbd
  panel=$(load_var panel 40)
  kbd=$(load_var kbd 2)
  rm -f "$WANT_FILE"
  rm -f "$TOGGLE_FLAG"

  if command -v kbd-backlight-schedule >/dev/null 2>&1; then
    kbd-backlight-schedule apply >/dev/null 2>&1 || set_level "$KBD_DEV" "$kbd"
  else
    set_level "$KBD_DEV" "$kbd"
  fi
  set_level "$PANEL_DEV" "$panel"
  hyprctl reload >/dev/null 2>&1 || true
  echo "studio-dock-lights: undock (panel→${panel}, laptop LCD on)"
}

cmd_auto() {
  if studio_connected; then
    cmd_dock
  else
    # Debounce: require a second check before undocking
    sleep 1
    if studio_connected; then
      cmd_dock
    else
      cmd_undock
    fi
  fi
}

cmd_status() {
  echo "studio=$(studio_connected && echo yes || echo no)"
  echo "want=$(cat "$WANT_FILE" 2>/dev/null || echo auto)"
  echo "toggle_file=$([[ -f $TOGGLE_FLAG ]] && echo yes || echo no)"
  echo "panel=$(get_level "$PANEL_DEV") device=$PANEL_DEV"
  echo "kbd=$(get_level "$KBD_DEV") device=$KBD_DEV"
}

case "${1:-auto}" in
  dock) cmd_dock ;;
  undock) cmd_undock ;;
  auto) cmd_auto ;;
  status) cmd_status ;;
  *)
    echo "Usage: studio-dock-lights [auto|dock|undock|status]" >&2
    exit 1
    ;;
esac
