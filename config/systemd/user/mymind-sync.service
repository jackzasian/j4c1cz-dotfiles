[Unit]
Description=Hermes Mind bookmark sync to j4c1cz.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/mymind-sync
Restart=always
RestartSec=10
EnvironmentFile=-%h/.config/mymind/env
EnvironmentFile=-%h/.hermes/.env

[Install]
WantedBy=default.target
