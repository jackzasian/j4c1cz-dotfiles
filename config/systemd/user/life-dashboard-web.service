[Unit]
Description=Life Dashboard web UI (activity streaks + status)
After=network-online.target

[Service]
ExecStart=%h/Projects/life-dashboard/bin/life-dashboard-serve.sh
Environment=HOME=%h
Environment=LIFE_DASHBOARD_HOST=100.81.159.105
Environment=LIFE_DASHBOARD_PORT=8780
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
