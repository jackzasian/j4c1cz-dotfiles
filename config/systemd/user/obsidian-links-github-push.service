[Unit]
Description=Push Obsidian Links/ to private GitHub vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/obsidian-links-github-push
Environment=HOME=%h
Environment=http_proxy=http://127.0.0.1:7897
Environment=https_proxy=http://127.0.0.1:7897
