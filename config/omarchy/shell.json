{
  "version": 1,
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "jackz.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/spotify-status.sh",
          "fontSize": 22,
          "id": "spotify",
          "interval": 2,
          "onClick": "playerctl -p spotify play-pause",
          "onRightClick": "uwsm-app -- spotify",
          "tooltip": true,
          "type": "command"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/tasknotes-upcoming.py",
          "fontSize": 22,
          "id": "tasknotes",
          "interval": 20,
          "onClick": "omarchy-shell -q shell reloadConfig; uwsm-app -- obsidian",
          "onRightClick": "~/.config/omarchy/bar/scripts/tasknotes-upcoming.py --force >/dev/null; omarchy-shell -q shell reloadConfig",
          "tooltip": true,
          "type": "command"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "ScreenRecording",
            "Dnd"
          ]
        },
        {
          "birthYear": 2008,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 30
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/agents-status.sh",
          "fontSize": 22,
          "id": "hermes-gateway",
          "interval": 10,
          "tooltip": true,
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/ai-tool-status.sh cc",
          "fontSize": 22,
          "id": "ai-claude-code",
          "interval": 2,
          "tooltip": true,
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/ai-tool-status.sh cu",
          "fontSize": 22,
          "id": "ai-cursor",
          "interval": 2,
          "tooltip": true,
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/ai-tool-status.sh oc",
          "fontSize": 22,
          "id": "ai-opencode",
          "interval": 2,
          "tooltip": true,
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/ai-tool-status.sh cd",
          "fontSize": 22,
          "id": "ai-claude-desktop",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus com.anthropic.Claude \"uwsm-app -- /home/jackz/.local/bin/claude-launch\"",
          "onRightClick": "pkill -f '/usr/lib/claude-desktop/claude' ; sleep 1 ; uwsm-app -- /home/jackz/.local/bin/claude-launch",
          "tooltip": true,
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/voxtype-status-wrapper.sh",
          "fontSize": 22,
          "id": "voxtype",
          "interval": 5,
          "onClick": "omarchy-voxtype-model",
          "onRightClick": "omarchy-voxtype-config",
          "tooltip": true,
          "type": "command"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/syncthing-status.sh",
          "fontSize": 22,
          "id": "syncthing",
          "interval": 15,
          "onClick": "xdg-open http://127.0.0.1:8384",
          "tooltip": true,
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/kdeconnect-status.sh",
          "fontSize": 22,
          "id": "kdeconnect",
          "interval": 5,
          "onClick": "uwsm-app -- kdeconnect-app",
          "tooltip": true,
          "type": "command"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/clash-geo-status.sh",
          "fontSize": 22,
          "id": "clash-geo",
          "interval": 60,
          "onClick": "uwsm-app -- clash-verge",
          "onRightClick": "rm -f ~/.cache/waybar-status/clash-geo.json; omarchy-shell -q shell reloadConfig",
          "tooltip": true,
          "type": "command"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "id": "jackz.bar"
  },
  "plugins": [
    {
      "id": "omarchy.agents"
    }
  ]
}