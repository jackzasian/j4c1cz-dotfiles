diff --git c/tests/catalog-fetch-test.sh w/tests/catalog-fetch-test.sh
index abeab0c..5df9012 100755
--- c/tests/catalog-fetch-test.sh
+++ w/tests/catalog-fetch-test.sh
@@ -6,7 +6,15 @@ ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
 PANEL="$ROOT/Panel.qml"
 HELPER="$ROOT/marketplace-catalog.sh"
 TMP=$(mktemp -d)
-trap 'rm -rf -- "$TMP"' EXIT
