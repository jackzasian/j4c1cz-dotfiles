+}
+trap cleanup EXIT
 
 grep -Fq 'Qt.resolvedUrl("marketplace-catalog.sh")' "$PANEL"
 grep -Fq 'marketplaceProcess.command = [root.marketplaceHelperPath]' "$PANEL"
@@ -48,4 +56,69 @@ jq -e '.plugins[0] == {
 }' <<< "$SUMMARY" >/dev/null
 test "$(wc -c <<< "$SUMMARY")" -lt 4096
 
+# The live catalog is large enough to time out on slower links without gzip.
+# Exercise negotiation and the decompressed size limit with a local server.
+python3 -I - "$FIXTURE" "$TMP/endpoint" <<'PY' &
+import gzip
+import http.server
+import pathlib
+import sys
+
+catalog = gzip.compress(pathlib.Path(sys.argv[1]).read_bytes())
+oversized = gzip.compress(b'{"plugins":[],"ignored":"' + b'x' * 16777216 + b'"}')
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        if 'gzip' not in self.headers.get('Accept-Encoding', ''):
+            self.send_error(408, 'Compression required on this slow link')
+            return
+        body = oversized if self.path == '/oversized' else catalog
+        self.send_response(200)
+        self.send_header('Content-Type', 'application/json')
+        self.send_header('Content-Encoding', 'gzip')
+        self.send_header('Content-Length', str(len(body)))
+        self.end_headers()
+        try:
+            self.wfile.write(body)
+        except (BrokenPipeError, ConnectionResetError):
+            pass
+
+    def log_message(self, *_args):
+        pass
+
+with http.server.HTTPServer(('127.0.0.1', 0), Handler) as server:
+    pathlib.Path(sys.argv[2]).write_text(f'http://127.0.0.1:{server.server_port}')
+    server.serve_forever()
+PY
+SERVER_PID=$!
+for _ in {1..100}; do
+  [[ -s $TMP/endpoint ]] && break
+  sleep 0.01
+done
+test -s "$TMP/endpoint"
+ENDPOINT=$(<"$TMP/endpoint")
+SUMMARY=$("$HELPER" "$ENDPOINT/catalog")
+jq -e '.plugins | length == 1' <<< "$SUMMARY" >/dev/null
+if "$HELPER" "$ENDPOINT/oversized" > "$TMP/oversized.out" 2>/dev/null; then
+  printf 'FAIL: compressed catalogs above the decompressed size cap must be rejected\n' >&2
+  exit 1
+fi
+
+# Desktop services do not inherit the interactive shell's proxy variables.
+mkdir "$TMP/bin"
+cat > "$TMP/bin/curl" <<'SH'
+#!/bin/bash
+printf '%s\n' "${https_proxy:-${HTTPS_PROXY:-${all_proxy:-${ALL_PROXY:-}}}}" > "$OMAPLUG_TEST_PROXY_CAPTURE"
+printf '{"plugins":[]}\n'
+SH
+chmod +x "$TMP/bin/curl"
+env -u https_proxy -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
+  PATH="$TMP/bin:$PATH" OMAPLUG_TEST_PROXY_CAPTURE="$TMP/proxy" \
+  "$HELPER" >/dev/null
+test "$(<"$TMP/proxy")" == "http://127.0.0.1:7897"
+env -u https_proxy -u all_proxy -u ALL_PROXY HTTPS_PROXY=http://preferred.invalid:8080 \
+  PATH="$TMP/bin:$PATH" OMAPLUG_TEST_PROXY_CAPTURE="$TMP/proxy" \
+  "$HELPER" >/dev/null
+test "$(<"$TMP/proxy")" == "http://preferred.invalid:8080"
+
 printf 'catalog-fetch-test: ok\n'
