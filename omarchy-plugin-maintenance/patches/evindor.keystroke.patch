diff --git c/tests/local_guards_check.py w/tests/local_guards_check.py
new file mode 100644
index 0000000..fa94433
--- /dev/null
+++ w/tests/local_guards_check.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Exercise local privacy, confirmation and compact-menu guards offscreen."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+with tempfile.TemporaryDirectory(prefix="keystroke-local-guards-") as temp:
+    work = Path(temp)
+    project = work / "project"
+    shutil.copytree(root, project, ignore=shutil.ignore_patterns(".git", "tests", "__pycache__", "experiments"))
+    (work / "qs").symlink_to("/usr/share/omarchy/shell")
+    source = project / "Keystroke.qml"
+    qml = source.read_text().replace("  PanelWindow {", "  Window {\n    transientParent: null\n    width: 1000; height: 800")
+    qml = qml.replace("    anchors { top: true; bottom: true; left: true; right: true }\n", "")
+    source.write_text("\n".join(line for line in qml.splitlines() if "exclusionMode:" not in line and "WlrLayershell." not in line))
+    config = work / ".config/omarchy/keystroke.json"
+    config.parent.mkdir(parents=True)
+    config.write_text(json.dumps({"version": 1, "matching": {"mode": "off"}, "voice": {"enabled": False}, "providers": {"extensions": {"enabled": False}, "probe": {"enabled": True}, "clipboard": {"enabled": False}}}))
+    history = work / ".local/state/omarchy/clipboard-history.json"
+    history.parent.mkdir(parents=True)
+    history.write_text(json.dumps(["private sentinel"]))
+    probe = work / ".local/share/keystroke/extensions/probe"
+    probe.mkdir(parents=True)
+    (probe / "extension.json").write_text(json.dumps({"name": "Probe", "version": "1.0.0", "author": "Test", "description": "Guard probe", "apiVersion": 1}))
+    (probe / "Service.qml").write_text('''import QtQuick
+QtObject {
+  property var shell: null
+  property var extension: null
+  property string omarchyPath: ""
+  readonly property var provider: ({ apiVersion: 1, name: "Probe",
+    query: function(ctx) { return ctx.query === "guard" ? [{ id: "guard", title: "Guard", score: 1000, confirm: "Confirm guard?", confirmDetail: "Guard detail", confirmText: "Run guard", action: { type: "noop" } }] : [] },
+    activate: function(row, ctx) { ctx.host.statusMessage = "callback ran"; return { type: "noop" } }
+  })
+}
+''')
+    (work / "shell.qml").write_text('''import QtQuick
+import Quickshell
+import "project"
+import "project/providers"
+ShellRoot {
+  id: test
+  property int stage: 0
+  function check(ok, message) { if (!ok) { console.log("FAIL", message); Qt.quit(); throw Error(message) } }
+  function configure(master, probe, clipboard) {
+    palette.applyConfigText(JSON.stringify({ version: 1, matching: { mode: "off" }, voice: { enabled: false }, palette: { searchBarOnly: true }, providers: { extensions: { enabled: master }, probe: { enabled: probe }, clipboard: { enabled: clipboard } } }))
+  }
+  Keystroke { id: palette; omarchyPath: "/usr/share/omarchy" }
+  Clipboard { id: clipboard; host: palette }
+  Timer { interval: 150; repeat: true; running: true; onTriggered: {
+    switch (test.stage) {
+    case 0:
+      if (!palette.registry.manifests.probe) return
+      test.check(!palette.registry.services.probe, "master switch must block an enabled extension")
+      test.check(clipboard.entries.length === 0, "disabled clipboard must not read history")
+      test.configure(true, false, true)
+      test.stage = 1; return
+    case 1:
+      test.check(!palette.registry.services.probe, "individual switch must block an extension")
+      if (clipboard.entries.length !== 1) return
+      test.check(clipboard.entries[0].text === "private sentinel", "clipboard fixture must be readable when enabled")
+      test.configure(true, true, false)
+      test.stage = 2; return
+    case 2:
+      if (!palette.registry.services.probe || !palette.registry.services.probe.instance) return
+      test.check(clipboard.entries.length === 0, "disabling clipboard must clear loaded history")
+      palette.open('{"query":""}')
+      test.stage = 3; return
+    case 3:
+      var info = JSON.parse(palette.inspect())
+      test.check(info.searchOnly && !info.contentVisible && info.cardHeight === info.headerHeight, "empty palette must show only search")
+      palette.statusMessage = ""
+      palette.activate()
+      test.check(palette.statusMessage === "" && !palette.confirmPending, "empty search must never activate a hidden result")
+      palette.setQuery("guard")
+      test.stage = 4; return
+    case 4:
+      if (palette.pending || !palette.rows.length || palette.rows[0].title !== "Guard") return
+      test.check(!JSON.parse(palette.inspect()).searchOnly, "typed query must restore results")
+      palette.activate()
+      test.check(palette.confirmPending && palette.statusMessage !== "callback ran", "provider callback must wait for confirmation")
+      test.check(palette.confirmPending.detail === "Guard detail" && palette.confirmPending.confirmText === "Run guard", "confirmation metadata must survive the update")
+      palette.confirmPending = null
+      test.check(palette.statusMessage !== "callback ran", "canceling must not invoke callback")
+      palette.activate()
+      var run = palette.confirmPending.run
+      palette.confirmPending = null
+      run()
+      test.check(palette.statusMessage === "callback ran", "accepted confirmation must invoke callback")
+      test.configure(false, true, false)
+      test.stage = 5; return
+    case 5:
+      test.check(!palette.registry.services.probe, "turning master off must destroy loaded extension")
+      console.log("PASS local guards")
+      Qt.quit()
+    }
+  } }
+  Timer { interval: 9000; running: true; onTriggered: { console.log("FAIL timeout at stage " + test.stage); Qt.quit() } }
+}
+''')
+    env = dict(os.environ, HOME=str(work), XDG_RUNTIME_DIR=str(work), QT_QPA_PLATFORM="offscreen", QT_QPA_PLATFORMTHEME="generic", QT_QUICK_BACKEND="software", QML_IMPORT_PATH=str(work))
+    env.pop("DISPLAY", None)
+    env.pop("WAYLAND_DISPLAY", None)
+    result = subprocess.run(["quickshell", "-p", str(work / "shell.qml")], env=env, capture_output=True, text=True, timeout=15)
+    output = result.stdout + result.stderr
+    assert "PASS local guards" in output and "Error:" not in output and "ReferenceError" not in output and "FAIL" not in output, output
+    print("PASS: local privacy, confirmation and compact-menu guards")
