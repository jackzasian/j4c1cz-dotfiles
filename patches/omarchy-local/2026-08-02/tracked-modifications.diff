diff --git i/bin/omarchy-pkg-aur-accessible w/bin/omarchy-pkg-aur-accessible
index fae95172..3ec5f19f 100755
--- i/bin/omarchy-pkg-aur-accessible
+++ w/bin/omarchy-pkg-aur-accessible
@@ -2,5 +2,13 @@
 
 # omarchy:summary=Returns true if the AUR is up and available.
 
-curl -sf --connect-timeout 30 --retry 3 --retry-delay 3 -A "omarchy-update" \
+# shellcheck source=/dev/null
+source "${HOME}/.local/bin/omarchy-pkg-aur-env" 2>/dev/null || true
+
+port=7897
+if [[ -f ${HOME}/.local/share/io.github.clash-verge-rev.clash-verge-rev/config.yaml ]]; then
+  port=$(awk '/^mixed-port:/ {print $2; exit}' "${HOME}/.local/share/io.github.clash-verge-rev.clash-verge-rev/config.yaml")
+fi
+
+curl -sf --proxy "http://127.0.0.1:${port}" --connect-timeout 30 --retry 3 --retry-delay 3 -A "omarchy-update" \
   "https://aur.archlinux.org/rpc/?v=5&type=info&arg=base" >/dev/null
